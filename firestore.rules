rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public Admin Settings (e.g. payment_config)
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Hardware Trials: Direct client write and read allowed for authenticated users
    match /hardware_trials/{hardwareId} {
      allow read, write: if isAuthenticated();
    }

    // User Trials: Prevents duplicate trials across devices
    match /user_trials/{userId} {
      allow read, write: if isAuthenticated();
    }

    // User Licensing: Points Balance, Active Pass, and Hourly Feature Unlocks
    match /users_licensing/{userKey} {
      allow read, write: if isAuthenticated();
    }

    // Received Bank UPI Payments
    match /received_payments/{utr} {
      allow read, write: if isAuthenticated();
    }

    // Pending UTR Verifications
    match /pending_verifications/{utr} {
      allow read, write: if isAuthenticated();
    }

    // Users Collection (Referral Tracking)
    match /users/{userId} {
      allow read, write: if isAuthenticated();

      match /referrals/{refereeId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
