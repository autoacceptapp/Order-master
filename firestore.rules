rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // App Settings (e.g. global kill switch app_settings/global)
    // All client apps can read; client writes are strictly disallowed (Admin only).
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Public Admin Settings (e.g. payment_config)
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Pending UTR Verifications
    match /pending_verifications/{utr} {
      allow read, write: if isAuthenticated();
    }

    // 100% Locked down for clients.
    // Client has read-only access; users cannot modify banUntil, points, or licensing.
    // Only Admin (via Firebase Admin SDK or Cloud Functions) can write here.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /referrals/{refereeId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Action Queue: Client creates requests, listens to their own status, no updates/deletions
    match /pending_actions/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == resource.data.firebaseUid;
      allow update, delete: if false;
    }

    // UTRs are entirely hidden from the client side.
    match /received_payments/{utr} {
      allow read, write: if false;
    }
  }
}
