rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // App Settings (e.g. global kill switch app_settings/global)
    // All client apps can read; client writes are strictly disallowed (Admin only).
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Public Admin Settings (e.g. payment_config)
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Pending UTR Verifications: creator can create and view their own UTR submission
    match /pending_verifications/{utr} {
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.firebaseUid == request.auth.uid
      );
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.firebaseUid == request.auth.uid
      );
      allow update, delete: if false; // Only cloud backend/admin can verify or delete
    }

    // Global Announcements & In-App Popups for all users
    match /global_messages/{messageId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Users collection & referral subcollections
    match /users/{userId} {
      // Allow get for anyone to inspect device licensing and trial status by document ID
      allow get: if true;
      // Listing or querying collection requires authentication
      allow list: if isAuthenticated();
      
      // User can create their initial profile without setting restricted fields
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.resource.data.firebaseUid == request.auth.uid
      ) && (
        !('isBanned' in request.resource.data) || request.resource.data.isBanned == false
      ) && (
        !('pointsBalance' in request.resource.data) || request.resource.data.pointsBalance == 0
      );

      // User can update their profile, but server-controlled fields are strictly immutable from client
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.resource.data.firebaseUid == request.auth.uid ||
        (resource != null && resource.data.firebaseUid == request.auth.uid)
      ) && (
        (!('pointsBalance' in request.resource.data) || request.resource.data.pointsBalance == resource.data.pointsBalance) &&
        (!('passExpiresAt' in request.resource.data) || request.resource.data.passExpiresAt == resource.data.passExpiresAt) &&
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == resource.data.isBanned) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );

      allow delete: if false;

      // Targeted In-App Messages for specific user
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || resource.data.targetUid == request.auth.uid);
        allow write: if false; // Admin only
      }

      match /referrals/{refereeId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Action Queue: Client creates requests, listens to their own status, and deletes after completion
    match /pending_actions/{docId} {
      allow create: if isAuthenticated() && request.resource.data.firebaseUid == request.auth.uid;
      allow read, delete: if isAuthenticated() && resource.data.firebaseUid == request.auth.uid;
      allow update: if false;
    }

    // Received payments: Authenticated users can read to verify payment and claim their own pass
    match /received_payments/{utr} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        !resource.data.isUsed ||
        resource.data.claimedByUserId == request.auth.uid ||
        request.resource.data.claimedByUserId == request.auth.uid
      );
      allow create, delete: if false;
    }
  }
}
