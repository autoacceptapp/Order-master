rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidInitialPoints(data) {
      return data.points == 50;
    }

    function isAntiFraudHardwareIdValid(docId, data) {
      return data.hardware_id == docId;
    }

    // Admin Settings (e.g., payment_config for dynamic UPI ID)
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Hardware Trials: 100% Free Anti-Fraud Lock
    // 1. Only allow document creation if it doesn't already exist (!exists)
    // 2. Enforce that claimedByUid perfectly matches request.auth.uid
    // 3. Document ID must match hardwareId
    // 4. Updates and deletes are prohibited to prevent trial resetting
    match /hardware_trials/{hardwareId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && !exists(/databases/$(database)/documents/hardware_trials/$(hardwareId))
                    && request.resource.data.claimedByUid == request.auth.uid
                    && request.resource.data.hardwareId == hardwareId
                    && request.resource.data.isUsed == true;
      allow update, delete: if false;
    }

    // User Trials: Prevents single Google account from claiming trials on multiple devices
    match /user_trials/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && !exists(/databases/$(database)/documents/user_trials/$(userId))
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // User Licensing: Stores Points Balance and Active Pass details
    // Only the authenticated owner can read and update their own document's pointsBalance
    match /users_licensing/{userKey} {
      allow read: if isAuthenticated() && (request.auth.uid == userKey || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.auth.uid == userKey || request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (request.auth.uid == userKey || resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // Users Collection (Referrals & DRM Profile)
    match /users/{hardwareId} {
      allow read: if true;

      allow create: if isAntiFraudHardwareIdValid(hardwareId, request.resource.data)
                    && isValidInitialPoints(request.resource.data)
                    && request.resource.data.has_used_referral == false
                    && request.resource.data.referral_count == 0;

      allow update: if 
        (
          resource.data.has_used_referral == false &&
          request.resource.data.has_used_referral == true &&
          request.resource.data.points == resource.data.points &&
          request.resource.data.hardware_id == resource.data.hardware_id &&
          request.resource.data.referral_code == resource.data.referral_code
        )
        ||
        (
          request.resource.data.points == resource.data.points + 20 &&
          request.resource.data.referral_count == resource.data.referral_count + 1 &&
          request.resource.data.hardware_id == resource.data.hardware_id &&
          request.resource.data.referral_code == resource.data.referral_code &&
          request.resource.data.has_used_referral == resource.data.has_used_referral
        );

      allow delete: if false;

      match /referrals/{refereeHardwareId} {
        allow read: if true;
        allow create: if !exists(/databases/$(database)/documents/users/$(hardwareId)/referrals/$(refereeHardwareId))
                      && request.resource.data.reward_points == 20
                      && request.resource.data.referee_hardware_id == refereeHardwareId;
        allow update, delete: if false;
      }
    }

    // Payment verification collections
    match /received_payments/{utr} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /pending_verifications/{utr} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
