rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // App Settings (e.g. global kill switch app_settings/global)
    // All client apps can read; client writes are strictly disallowed (Admin only).
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Public Admin Settings (e.g. payment_config)
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Pending UTR Verifications
    match /pending_verifications/{utr} {
      allow read, write: if isAuthenticated();
    }

    // Global Announcements & In-App Popups for all users
    match /global_messages/{messageId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only
    }

    // Users collection & referral subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null;

      // Targeted In-App Messages for specific user
      match /messages/{messageId} {
        allow read: if request.auth != null && (request.auth.uid == userId || resource.data.targetUid == request.auth.uid);
        allow write: if false; // Admin only
      }

      match /referrals/{refereeId} {
        allow read, write: if request.auth != null;
      }
    }

    // Action Queue: Client creates requests, listens to their own status, and deletes after completion
    match /pending_actions/{docId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.firebaseUid;
      allow update: if false;
    }

    // UTRs are entirely hidden from the client side.
    match /received_payments/{utr} {
      allow read, write: if false;
    }
  }
}
